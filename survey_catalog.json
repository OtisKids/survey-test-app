{
    "personal": {
        "title": "Basic Personal Well-Being Survey",
        "description": "Assess general life satisfaction, emotional state, social support, and health.",
        "questions": [
            {
                "id": "life_satisfaction",
                "note": "1 = Very dissatisfied, 5 = Very satisfied",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "text": "Overall, how satisfied are you with your life right now?",
                "type": "likert"
            },
            {
                "id": "positive_emotion",
                "note": "1 = Almost never, 5 = Almost always",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "text": "In the past week, how often have you felt happy or content?",
                "type": "likert"
            },
            {
                "id": "negative_emotion",
                "note": "1 = Almost always, 5 = Almost never",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "text": "In the past week, how often have you felt anxious or sad?",
                "type": "likert"
            },
            {
                "id": "social_support",
                "note": "1 = Not at all, 5 = Extremely",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "text": "Do you feel that you have someone you can reliably turn to for support during difficult times?",
                "type": "likert"
            },
            {
                "id": "physical_health",
                "note": "1 = Very poor, 5 = Excellent",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "text": "Rate your current physical health.",
                "type": "likert"
            },
            {
                "id": "mental_health",
                "note": "1 = Very poor, 5 = Excellent",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "text": "Rate your current mental health.",
                "type": "likert"
            },
            {
                "id": "open_personal",
                "text": "Please describe any factors in your personal life that significantly contribute to your overall well-being.",
                "type": "text"
            },
            {
                "id": "sleep_health",
                "note": "1 = Very poor, 5 = Excellent",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "text": "Rate your current sleep health.",
                "type": "likert"
            }
        ]
    },
    "work": {
        "title": "Basic Work Environment Well-Being Survey",
        "description": "Assess job satisfaction, engagement, work-life balance, and support at work.",
        "questions": [
            {
                "id": "job_satisfaction",
                "text": "How satisfied are you with your current job?",
                "type": "likert",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "note": "1 = Very dissatisfied, 5 = Very satisfied"
            },
            {
                "id": "work_engagement",
                "text": "How engaged do you feel in your daily work tasks?",
                "type": "likert",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "note": "1 = Not at all engaged, 5 = Fully engaged"
            },
            {
                "id": "work_balance",
                "text": "How well do you feel you can balance work responsibilities with your personal life?",
                "type": "likert",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "note": "1 = Very poorly, 5 = Exceptionally well"
            },
            {
                "id": "work_support",
                "text": "How supported do you feel by your colleagues and supervisors?",
                "type": "likert",
                "scale": [
                    1,
                    2,
                    3,
                    4,
                    5
                ],
                "note": "1 = Not at all, 5 = Extremely"
            },
            {
                "id": "open_work",
                "text": "What changes or improvements in your workplace would most enhance your well-being?",
                "type": "text"
            }
        ]
    },
